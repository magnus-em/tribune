NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Resend (transactional email + inbound landlord replies)
# RESEND_API_KEY=re_your_api_key
# RESEND_FROM_EMAIL=hello@yourdomain.com
# RESEND_WEBHOOK_SECRET=whsec_...   # signing secret for the inbound webhook (Resend dashboard)

# Inbound webhook needs the service-role key to write without a user session (bypasses RLS)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ADMIN_EMAIL=you@yourdomain.com    # where landlord-reply alerts are sent

# Lease auto-extraction (optional — intake works without it)
# XAI_API_KEY=xai-...

# Payment instructions shown on invoices (Venmo/Zelle)
# NEXT_PUBLIC_TRIBUNE_PAYMENT_PHONE=2035551234

# Sentry (error tracking) - OPTIONAL
# Get your DSN from https://sentry.io after creating a project
# NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/your-project-id
# SENTRY_DSN=https://your-dsn@sentry.io/your-project-id
